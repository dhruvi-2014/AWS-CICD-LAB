<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Coffee Suppliers</title><link rel="stylesheet" href="/styles.css"></head><body><main class="container"><header class="header"><div><h1>Coffee Suppliers</h1><p>Supplier directory for customers.</p></div><a class="button secondary" href="/admin">Administrator</a></header><section class="card"><table><thead><tr><th>Name</th><th>Address</th><th>City</th><th>State</th><th>Email</th><th>Phone</th></tr></thead><tbody><% suppliers.forEach((supplier)=>{ %><tr><td><%= supplier.name %></td><td><%= supplier.address %></td><td><%= supplier.city %></td><td><%= supplier.state %></td><td><%= supplier.email %></td><td><%= supplier.phone %></td></tr><% }) %></tbody></table></section></main></body></html>
