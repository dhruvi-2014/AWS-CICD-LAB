<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Coffee Suppliers</title><link rel="stylesheet" href="/styles.css"></head><body><main class="container"><header class="header"><div><h1>Manage Coffee Suppliers</h1><p>Administrator interface for supplier management.</p></div><a class="button secondary" href="/">Customer Home</a></header><section class="card"><h2><%= editing?'Edit Supplier':'Add New Supplier' %></h2><form method="post" action="<%= editing?'/admin/suppliers/'+editing.id:'/admin/suppliers' %>" class="form-grid"><input name="name" placeholder="Name" required value="<%= editing?.name||'' %>"><input name="address" placeholder="Address" required value="<%= editing?.address||'' %>"><input name="city" placeholder="City" required value="<%= editing?.city||'' %>"><input name="state" placeholder="State" required value="<%= editing?.state||'' %>"><input name="email" type="email" placeholder="Email" required value="<%= editing?.email||'' %>"><input name="phone" placeholder="Phone" required value="<%= editing?.phone||'' %>"><button class="button" type="submit"><%= editing?'Update Supplier':'Add Supplier' %></button><% if(editing){ %><a class="button secondary" href="/admin">Cancel</a><% } %></form></section><section class="card"><h2>Suppliers</h2><table><thead><tr><th>Name</th><th>City</th><th>State</th><th>Email</th><th>Phone</th><th>Action</th></tr></thead><tbody><% suppliers.forEach((supplier)=>{ %><tr><td><%= supplier.name %></td><td><%= supplier.city %></td><td><%= supplier.state %></td><td><%= supplier.email %></td><td><%= supplier.phone %></td><td><a href="/admin/suppliers/<%= supplier.id %>/edit">Edit</a></td></tr><% }) %></tbody></table></section></main></body></html>
